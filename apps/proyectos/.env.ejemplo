# Claves de la web de proyectos. Este fichero SÍ se sube a git (sin claves de verdad); el .env NO (.gitignore).
# En el servidor, desplegar.sh crea el .env copiando este si no existe, y pone una clave aleatoria
# donde ponga __ALEATORIA__. En tu PC, cópialo a mano a .env.

# Firma las cookies de sesión del alumnado. Si cambia, todo el mundo tiene que volver a entrar.
CLAVE_SESION=__ALEATORIA__

# Clave SOLO del profesorado, para admin.sh (importar alumnos, cambiar contraseñas, borrar). La ves con: cat .env
CLAVE_ADMIN=__ALEATORIA__

# Días que dura una sesión iniciada
DIAS_SESION=30
