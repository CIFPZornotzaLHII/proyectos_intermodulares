# Windows / macOS
desktop.ini
Thumbs.db
.DS_Store

# Editores
.vscode/
.idea/

# Node
node_modules/

# Carpetas de trabajo temporal
_borrar/

# Aplicaciones: claves y datos (viven en el servidor, no en git)
apps/*/datos/*
!apps/*/datos/.gitkeep
apps/*/.env

# Vídeos: nunca en el repo (se enlazan desde proyecto.json)
*.mp4
*.mov
*.mkv
*.webm
*.avi
apps/proyectos/web/node_modules/
apps/proyectos/web/dist/

# Fábrica (factory-boilerplate): estado de ejecución y datos en marcha, nunca en main
factory/jobs/*
!factory/jobs/.gitkeep
factory/metrics.json
factory/skills-usage.json
factory/approvals/
factory/PAUSED
.claude/settings.local.json
